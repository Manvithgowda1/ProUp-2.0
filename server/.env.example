PROJECT_NAME="Proup API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# Local SQLite Async for development:
DATABASE_URL="sqlite+aiosqlite:///./proup.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/proup_db"

# JWT Authentication
SECRET_KEY="replace_this_with_a_super_secret_key_generated_with_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Whitelist (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
